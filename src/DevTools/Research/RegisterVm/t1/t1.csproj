<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone: not part of any solution. MoonSharpDll: a netstandard2.0 build of spike/register-vm
       (it reads ScriptOptions.RegisterVm and the spike's RegisterCompiler counters). -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable><Optimize>true</Optimize><InvariantGlobalization>true</InvariantGlobalization></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Benchmarks/LuaCSharpScripts.cs" Link="LuaCSharpScripts.cs" />
    <Reference Include="MoonSharp.Interpreter"><HintPath>$(MoonSharpDll)</HintPath></Reference>
  </ItemGroup>
</Project>
