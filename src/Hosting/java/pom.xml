<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.moonsharp.hosting</groupId>
  <artifactId>moonsharp-hosting-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MoonSharp hosting for the JVM</name>

  <modules>
    <module>client</module>
    <module>spring-sample</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.3</junit.version>
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- Built by: dotnet build -c Release src/Hosting/MoonSharp.Hosting.Cli -->
    <moonsharp.host.dll>${maven.multiModuleProjectDirectory}/../MoonSharp.Hosting.Cli/bin/Release/net8.0/moonsharp-host.dll</moonsharp.host.dll>
    <moonsharp.fixtures>${maven.multiModuleProjectDirectory}/../fixtures</moonsharp.fixtures>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.1</version>
          <configuration>
            <systemPropertyVariables>
              <moonsharp.host.dll>${moonsharp.host.dll}</moonsharp.host.dll>
              <moonsharp.fixtures>${moonsharp.fixtures}</moonsharp.fixtures>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
