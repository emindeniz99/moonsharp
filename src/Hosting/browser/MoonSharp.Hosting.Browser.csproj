<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- MoonSharp.Interpreter is trimmed like any other assembly: its embedded ILLink.Descriptors.xml
             keeps the standard library it registers by reflection. Rooting the whole assembly cost
             71 KB brotli (docs/hosting.md, "Browser budget"). -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MoonSharp.Hosting\MoonSharp.Hosting.csproj" />
    </ItemGroup>

</Project>
