<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.moonsharp.hosting</groupId>
  <artifactId>moonsharp-hosting-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MoonSharp hosting for the JVM</name>

  <modules>
    <module>client</module>
    <module>spring-sample</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.3</junit.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- Newer than the Tomcat that Spring Boot 4.1.1 manages (11.0.24), which has a known critical CVE
         (GHSA-f525-44xv-f2qj, fixed in 11.0.25). -->
    <tomcat.version>11.0.27</tomcat.version>
    <!-- Built by: dotnet build -c Release src/Hosting/MoonSharp.Hosting.Cli -->
    <moonsharp.host.dll>${maven.multiModuleProjectDirectory}/../MoonSharp.Hosting.Cli/bin/Release/net8.0/moonsharp-host.dll</moonsharp.host.dll>
    <moonsharp.fixtures>${maven.multiModuleProjectDirectory}/../fixtures</moonsharp.fixtures>
    <!-- In-process variants (docs/hosting.md, "Java: in process"). Their tests are skipped when these are
         missing, unless -Dmoonsharp.inprocess.required=true. -->
    <moonsharp.jni.lib>${maven.multiModuleProjectDirectory}/../native/build/libmoonsharp_jni.so</moonsharp.jni.lib>
    <moonsharp.native.dll>${maven.multiModuleProjectDirectory}/../MoonSharp.Hosting.Native/bin/Release/net8.0/MoonSharp.Hosting.Native.dll</moonsharp.native.dll>
    <moonsharp.aot.lib>${maven.multiModuleProjectDirectory}/../MoonSharp.Hosting.Native/bin/Release/net8.0/linux-x64/publish/MoonSharp.Hosting.Native.so</moonsharp.aot.lib>
    <moonsharp.inprocess.required>false</moonsharp.inprocess.required>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Declared before the Spring Boot BOM so these versions win. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.3.1</version>
          <configuration>
            <!-- One JVM per test class: a process can load MoonSharp in process only once, either
                 through CoreCLR or as NativeAOT. -->
            <reuseForks>false</reuseForks>
            <systemPropertyVariables>
              <moonsharp.host.dll>${moonsharp.host.dll}</moonsharp.host.dll>
              <moonsharp.fixtures>${moonsharp.fixtures}</moonsharp.fixtures>
              <moonsharp.jni.lib>${moonsharp.jni.lib}</moonsharp.jni.lib>
              <moonsharp.native.dll>${moonsharp.native.dll}</moonsharp.native.dll>
              <moonsharp.aot.lib>${moonsharp.aot.lib}</moonsharp.aot.lib>
              <moonsharp.inprocess.required>${moonsharp.inprocess.required}</moonsharp.inprocess.required>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
