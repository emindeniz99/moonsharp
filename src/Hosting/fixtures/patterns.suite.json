{
  "suite": "patterns",
  "description": "Lua patterns through string.find, match, gmatch and gsub: captures, anchors, classes and error messages.",
  "cases": [
    {"name": "find: plain search ignores magic characters", "op": "run", "chunk": "patterns.lua", "source": "return { ('a.b.c'):find('.', 1, true), ('a.b.c'):find('.', 3, true) }", "expect": [2, 4, 4]},
    {"name": "find: empty pattern at and past the end", "op": "run", "chunk": "patterns.lua", "source": "return { ('abc'):find('', 10) == nil, ('abc'):find('', 4) }", "expect": [true, 4, 3]},
    {"name": "find: negative init", "op": "run", "chunk": "patterns.lua", "source": "return { ('abc'):find('b', -1) == nil, ('abc'):find('b', -2) }", "expect": [true, 2, 2]},
    {"name": "find: returns captures after the positions", "op": "run", "chunk": "patterns.lua", "source": "return { ('key = value'):find('(%w+)%s*=%s*(%w+)') }", "expect": [1, 11, "key", "value"]},
    {"name": "find: anchors", "op": "run", "chunk": "patterns.lua", "source": "return { ('hello'):find('^h'), ('hello'):find('^e') == nil, ('hello'):find('o$'), ('hello'):find('l$') == nil, ('a^b'):find('a^b') }", "expect": [1, true, 5, true, 1, 3]},
    {"name": "match: captures", "op": "run", "chunk": "patterns.lua", "source": "return { ('2024-01-15'):match('(%d+)-(%d+)-(%d+)') }", "expect": ["2024", "01", "15"]},
    {"name": "match: lazy trim", "op": "run", "chunk": "patterns.lua", "source": "return ('  trim  '):match('^%s*(.-)%s*$')", "expect": "trim"},
    {"name": "match: position captures", "op": "run", "chunk": "patterns.lua", "source": "return { ('abc'):match('()b()') }", "expect": [2, 3]},
    {"name": "match: no match is nil", "op": "run", "chunk": "patterns.lua", "source": "return ('abc'):match('x') == nil", "expect": true},
    {"name": "match: init and anchors", "op": "run", "chunk": "patterns.lua", "source": "return { ('abcabc'):match('b', 3), ('abcabc'):match('b', -2), ('abc'):match('^b', 2) }", "expect": ["b", "b", "b"]},
    {"name": "gsub: string replacement with captures", "op": "run", "chunk": "patterns.lua", "source": "return { (('hello world'):gsub('o', '0')), (('hello world'):gsub('(%w+)', '<%1>')) }", "expect": ["hell0 w0rld", "<hello> <world>"]},
    {"name": "gsub: returns the count", "op": "run", "chunk": "patterns.lua", "source": "local s, n = ('hello world'):gsub('(%w+)', '<%1>') return { s, n }", "expect": ["<hello> <world>", 2]},
    {"name": "gsub: %0 and an escaped %", "op": "run", "chunk": "patterns.lua", "source": "return { (('abc'):gsub('%w', '%0%0')), (('50'):gsub('%d+', '%%%0')) }", "expect": ["aabbcc", "%50"]},
    {"name": "gsub: empty pattern matches between characters", "op": "run", "chunk": "patterns.lua", "source": "local s, n = ('abc'):gsub('', '-') return { s, n }", "expect": ["-a-b-c-", 4]},
    {"name": "gsub: limit on replacements", "op": "run", "chunk": "patterns.lua", "source": "local s, n = ('hello'):gsub('l', 'L', 1) return { s, n }", "expect": ["heLlo", 1]},
    {"name": "gsub: table replacement, false keeps the match", "op": "run", "chunk": "patterns.lua", "source": "local s, n = ('$a $b $c'):gsub('%$(%w+)', { a = 'A', b = false }) return { s, n }", "expect": ["A $b $c", 3]},
    {"name": "gsub: function replacement, nil keeps the match", "op": "run", "chunk": "patterns.lua", "source": "local s, n = ('1 2 3'):gsub('%d', function(d) if d == '2' then return nil end return d * 10 end) return { s, n }", "expect": ["10 2 30", 3]},
    {"name": "gsub: anchored pattern replaces once", "op": "run", "chunk": "patterns.lua", "source": "return { (('  x  '):gsub('^%s+', '')), (('aaa'):gsub('^a', 'b')) }", "expect": ["x  ", "baa"]},
    {"name": "gsub: invalid capture index", "op": "run", "chunk": "patterns.lua", "source": "return ('abc'):gsub('b', '%2')", "expectError": {"kind": "runtime", "messageContains": "patterns.lua:(1,0-30): invalid capture index", "line": 1}},
    {"name": "gmatch: pairs of captures", "op": "run", "chunk": "patterns.lua", "source": "local r = {} for k, v in ('a=1, b=2, c=3'):gmatch('(%w+)=(%w+)') do r[#r + 1] = k .. v end return r", "expect": ["a1", "b2", "c3"]},
    {"name": "gmatch: words", "op": "run", "chunk": "patterns.lua", "source": "local r = {} for w in ('The quick  brown'):gmatch('%a+') do r[#r + 1] = w end return r", "expect": ["The", "quick", "brown"]},
    {"name": "gmatch: ^ is a literal character", "op": "run", "chunk": "patterns.lua", "source": "local r = {} for w in ('^a^b'):gmatch('^%a') do r[#r + 1] = w end return r", "expect": ["^a", "^b"]},
    {"name": "gmatch: empty position captures", "op": "run", "chunk": "patterns.lua", "source": "local r = {} for p in ('abc'):gmatch('()') do r[#r + 1] = p end return r", "expect": [1, 2, 3, 4]},
    {"name": "classes: %a %d %s %w %p %u %l %x %c", "op": "run", "chunk": "patterns.lua", "source": "local s = 'a1 _B!' return { (s:gsub('%a', 'A')), (s:gsub('%d', 'D')), (s:gsub('%s', 'S')), (s:gsub('%w', 'W')), (s:gsub('%p', 'P')), (s:gsub('%u', 'U')), (s:gsub('%l', 'L')), (('a1f_G'):gsub('%x', 'X')), (('a\\1b'):gsub('%c', 'C')) }", "expect": ["A1 _A!", "aD _B!", "a1S_B!", "WW _W!", "a1 PBP", "a1 _U!", "L1 _B!", "XXX_G", "aCb"]},
    {"name": "classes: letters below 256 are classified, others are not", "op": "run", "chunk": "patterns.lua", "source": "return { (('ğü1'):gsub('%a', 'A')), ('éa'):match('%l+'), ('İ'):match('%u') == nil }", "expect": ["ğA1", "éa", true], "note": "Lua 5.2 in the C locale sees UTF-8 bytes, none of them letters"},
    {"name": "sets and ranges", "op": "run", "chunk": "patterns.lua", "source": "return { ('foo_bar1 2baz'):match('[%a_][%w_]*'), (('abc123'):gsub('[^%d]', '')), (('a-b]c'):gsub('[%]%-]', '.')), ('xyz'):match('[x-y]+') }", "expect": ["foo_bar1", "123", "a.b.c", "xy"]},
    {"name": "quantifiers: - * ? +", "op": "run", "chunk": "patterns.lua", "source": "return { ('<a><b>'):match('<(.-)>'), ('<a><b>'):match('<(.*)>'), ('aaab'):match('a-b'), (('color colour'):gsub('colou?r', 'C')), ('aaa'):match('a+') }", "expect": ["a", "a><b", "aaab", "C C", "aaa"]},
    {"name": "balanced match and frontier", "op": "run", "chunk": "patterns.lua", "source": "return { ('f(a(b)c) x'):match('%b()'), (('THE (quick) fox'):gsub('%f[%a]%a+', 'W')), ('hello'):find('%f[%l]') }", "expect": ["(a(b)c)", "W (W) W", 1, 0]},
    {"name": "back references", "op": "run", "chunk": "patterns.lua", "source": "return { { ('say \"hi\" now'):match('([\"\\'])(.-)%1') }, { ('abba'):find('(a)(b)%2%1') } }", "expect": [["\"", "hi"], [1, 4, "a", "b"]]},
    {"name": "error: pattern ends with %", "op": "run", "chunk": "patterns.lua", "source": "return ('a'):find('%')", "expectError": {"kind": "runtime", "messageContains": "patterns.lua:(1,0-22): malformed pattern (ends with '%')", "line": 1}},
    {"name": "error: unfinished capture", "op": "run", "chunk": "patterns.lua", "source": "return ('a'):find('(a')", "expectError": {"kind": "runtime", "messageContains": "patterns.lua:(1,0-23): unfinished capture", "line": 1}},
    {"name": "error: missing ]", "op": "run", "chunk": "patterns.lua", "source": "return ('a'):find('[a')", "expectError": {"kind": "runtime", "messageContains": "patterns.lua:(1,0-23): malformed pattern (missing ']')", "line": 1}},
    {"name": "unmatched ) is a literal", "op": "run", "chunk": "patterns.lua", "source": "return ('a)'):find('a)')", "expect": 1, "note": "no magic character, so a plain search, as in Lua 5.2; match raises invalid pattern capture"},
    {"name": "error: %b without arguments", "op": "run", "chunk": "patterns.lua", "source": "return ('a'):find('%b')", "expectError": {"kind": "runtime", "messageContains": "patterns.lua:(1,0-23): malformed pattern (missing arguments to '%b')", "line": 1}},
    {"name": "error: %f without a set", "op": "run", "chunk": "patterns.lua", "source": "return ('a'):find('%f')", "expectError": {"kind": "runtime", "messageContains": "patterns.lua:(1,0-23): missing '[' after '%f' in pattern", "line": 1}}
  ]
}
