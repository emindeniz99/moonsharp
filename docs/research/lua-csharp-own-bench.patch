@@ -0,0 +1,48 @@
+extern alias msfork;
+using ForkCoreModules = msfork::MoonSharp.Interpreter.CoreModules;
+using ForkDynValue = msfork::MoonSharp.Interpreter.DynValue;
+using ForkScript = msfork::MoonSharp.Interpreter.Script;
+
+// Added to compare a MoonSharp fork build (not part of upstream Lua-CSharp).
+// Same code as MoonSharpComparison, compiled against the fork build
+// (assembly renamed to MoonSharpFork.Interpreter so it can sit next to the NuGet package).
+public sealed class MoonSharpForkComparison
+{
+    readonly ForkScript state = new(ForkCoreModules.Preset_Complete);
+    readonly ForkDynValue closure;
+
+    public MoonSharpForkComparison(string source)
+    {
+        state.Globals["host_add"] = ForkDynValue.NewCallback(
+            (context, args) => ForkDynValue.NewNumber(args[0].Number + args[1].Number)
+        );
+        closure = state.LoadString(source, codeFriendlyName: "comparison");
+    }
+
+    public double Run() => state.Call(closure).Number;
+
+    public static void WarmUp() => ForkScript.WarmUp();
+
+    public static string Version => typeof(ForkScript).Assembly.GetName().Version!.ToString();
+}
+
+// Mirrors CompilationComparison.ResetMoonSharp/MoonSharp for the fork.
+public sealed class MoonSharpForkCompiler
+{
+    ForkScript moon = default!;
+
+    public void Reset() => moon = new(ForkCoreModules.Preset_Complete);
+
+    public object Load(string source, int batch)
+    {
+        ForkDynValue result = default!;
+        for (var i = 0; i < batch; i++)
+            result = moon.LoadString(source, codeFriendlyName: "comparison");
+        return result;
+    }
+
+    public void Cleanup() => moon = default!;
+
+    // Mirrors StartupComparison.MoonSharp.
+    public static object NewState() => new ForkScript(ForkCoreModules.Preset_Complete);
+}
