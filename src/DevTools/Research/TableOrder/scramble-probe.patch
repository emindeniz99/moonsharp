+		// SCRAMBLE PROBE (temporary): MOONSHARP_ORDER_PROBE = "b" (array 1..Length first, then insertion order)
+		// or "c<seed>" (array 1..Length first, then a seeded hash order).
+		static readonly string s_Probe = System.Environment.GetEnvironmentVariable("MOONSHARP_ORDER_PROBE");
+
+		static uint ProbeHash(DynValue k, uint seed)
+		{
+			string s = k.Type + ":" + (k.Type == DataType.String ? k.String : k.Type == DataType.Number ? k.Number.ToString("R") : k.GetHashCode().ToString());
+			uint h = 2166136261u ^ seed;
+			foreach (char c in s) { h ^= c; h *= 16777619u; }
+			h ^= h >> 15; h *= 0x2c1b3c6du; h ^= h >> 12;
+			return h;
+		}
+
+		List<TablePair> ProbeOrder()
+		{
+			var all = m_Values.ToList();
+			if (string.IsNullOrEmpty(s_Probe)) return all;
+			int len = Length;
+			var arr = new List<TablePair>();
+			var rest = new List<TablePair>();
+			foreach (var p in all)
+			{
+				int idx = p.Key.Type == DataType.Number ? GetIntegralKey(p.Key.Number) : -1;
+				if (idx >= 1 && idx <= len) arr.Add(p); else rest.Add(p);
+			}
+			arr.Sort((x, y) => x.Key.Number.CompareTo(y.Key.Number));
+			if (s_Probe[0] == 'c')
+			{
+				uint seed = s_Probe.Length > 1 ? uint.Parse(s_Probe.Substring(1)) : 1u;
+				rest = rest.OrderBy(p => ProbeHash(p.Key, seed)).ToList();
+			}
+			arr.AddRange(rest);
+			return arr;
+		}
