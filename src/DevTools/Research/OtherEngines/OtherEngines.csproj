<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone: not part of any solution. One build per engine (README.md):
       EngineDll: the interpreter to measure, a MoonSharp.Interpreter.dll or WattleScript.Interpreter.dll;
       Wattle=true: compile against the WattleScript namespace (WattleScript after its rename). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Optimize>true</Optimize><Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion><InvariantGlobalization>true</InvariantGlobalization><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EngineDll Condition="'$(EngineDll)' == ''">$(MSBuildThisFileDirectory)../../../MoonSharp.Interpreter/bin/Release/netstandard2.0/MoonSharp.Interpreter.dll</EngineDll>
    <DefineConstants Condition="'$(Wattle)' == 'true'">$(DefineConstants);WATTLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="$([System.IO.Path]::GetFileNameWithoutExtension('$(EngineDll)'))"><HintPath>$(EngineDll)</HintPath></Reference>
  </ItemGroup>
</Project>
